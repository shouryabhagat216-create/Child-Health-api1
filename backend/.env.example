# Copy to .env and adjust. Never commit the real .env file.
PORT=3000
NODE_ENV=development

# "postgres" (default) or "memory" (no database needed, data lost on restart)
DB_MODE=postgres
DATABASE_URL=postgres://childhealth:childhealth@localhost:5432/childhealth

# --- Authentication (MOCK, synthetic guardians only) ---
# Secret used to sign login tokens. Use a long random value; required when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Only this browser origin may call the API (the React dev server).
CORS_ORIGIN=http://localhost:5173

# Rate limits per IP: general requests and (stricter) login attempts per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10

# --- ABDM SANDBOX (optional; leave ABDM_MODE=mock to use the local mock) ---
# Sandbox only. NEVER put production credentials here. The real values go in your own
# git-ignored .env file, never in this example file, in chat or in screenshots.
ABDM_MODE=mock
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in
ABDM_CM_ID=sbx
